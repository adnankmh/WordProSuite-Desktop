<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="E1643577-1358-45D7-A56A-C501CB4DB6DA"
           Name="WordPro Suite Desktop (x64)"
           Language="1033"
           Version="1.0.1.0"
           Manufacturer="WordPro Suite"
           UpgradeCode="28F98D43-C6EF-446E-AFF9-7F3DF1D959A5">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Platform="x64" />

    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="CompanyFolder" Name="WordPro Suite">
          <Directory Id="INSTALLFOLDER" Name="WordPro Suite Desktop" />
        </Directory>
      </Directory>
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="cmpAddInBinary" Guid="27946DA8-452A-4B81-8357-415B16A3D653" Win64="yes">
        <File Id="filAddIn"
              Source="$(var.AddInBin)\WordProSuite.AddIn.dll"
              KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Office recommends the Word Addins registration under HKCU. It is kept
         in a separate component so it is not mixed with Program Files data. -->
    <DirectoryRef Id="TARGETDIR">
      <Component Id="cmpCurrentUserWordRegistration" Guid="F633F4AC-8B34-4891-B272-139CB80F3882" Win64="no">
        <RegistryKey Root="HKCU"
                     Key="Software\Microsoft\Office\Word\Addins\WordProSuite.Desktop.AddIn">
          <RegistryValue Name="FriendlyName"
                         Type="string"
                         Value="WordPro Suite Desktop" />
          <RegistryValue Name="Description"
                         Type="string"
                         Value="Professional productivity tools for Microsoft Word." />
          <RegistryValue Name="LoadBehavior"
                         Type="integer"
                         Value="3"
                         KeyPath="yes" />
          <RegistryValue Name="CommandLineSafe"
                         Type="integer"
                         Value="0" />
        </RegistryKey>

        <!-- Remove stale Office resiliency entries for this product name when
             the MSI repairs/installs for the current user. -->
        <RemoveRegistryKey Id="removeOldAddinRegistration"
                           Root="HKCU"
                           Key="Software\Microsoft\Office\Word\Addins\WordProSuite.Desktop.AddIn"
                           Action="removeOnUninstall" />
      </Component>
    </DirectoryRef>

    <!-- RegAsm creates the complete and correct managed COM registration:
         CLSID, InprocServer32=mscoree.dll, Assembly, Class, RuntimeVersion,
         CodeBase and version subkeys. -->
    <CustomAction Id="RegisterManagedCom"
                  Directory="TARGETDIR"
                  ExeCommand="&quot;[WindowsFolder]Microsoft.NET\Framework64\v4.0.30319\RegAsm.exe&quot; &quot;[INSTALLFOLDER]WordProSuite.AddIn.dll&quot; /nologo /codebase"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <CustomAction Id="UnregisterManagedCom"
                  Directory="TARGETDIR"
                  ExeCommand="&quot;[WindowsFolder]Microsoft.NET\Framework64\v4.0.30319\RegAsm.exe&quot; &quot;[INSTALLFOLDER]WordProSuite.AddIn.dll&quot; /nologo /unregister"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="UnregisterManagedCom"
              Before="RemoveFiles">REMOVE="ALL"</Custom>
      <Custom Action="RegisterManagedCom"
              After="InstallFiles">NOT REMOVE</Custom>
    </InstallExecuteSequence>

    <Feature Id="MainFeature" Title="WordPro Suite Desktop" Level="1">
      <ComponentRef Id="cmpAddInBinary" />
      <ComponentRef Id="cmpCurrentUserWordRegistration" />
    </Feature>
  </Product>
</Wix>
